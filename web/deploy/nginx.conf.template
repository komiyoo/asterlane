upstream asterlane_gateway {
    server ${ASTERLANE_GATEWAY_UPSTREAM};
    keepalive 16;
}

server {
    listen ${ASTERLANE_WEB_LISTEN};
    server_name _;
    root ${ASTERLANE_WEB_ROOT};
    index index.html;
    absolute_redirect off;
    server_tokens off;
    client_max_body_size 32m;

    location = /admin/ui {
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options "nosniff" always;
        return 308 /;
    }

    location = /admin/ui/ {
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options "nosniff" always;
        return 308 /;
    }

    location = /admin {
        include ${ASTERLANE_ADMIN_PROXY};
    }

    location ^~ /admin/ {
        include ${ASTERLANE_ADMIN_PROXY};
    }

    location @gateway_down {
        internal;
        default_type application/json;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options "nosniff" always;
        return 503 '{"error":{"code":"gateway.unavailable","message":"admin API is unreachable"}}';
    }

    location = /healthz {
        default_type text/plain;
        add_header Cache-Control "no-store" always;
        return 404 "not found\n";
    }

    location = /versionz {
        default_type text/plain;
        add_header Cache-Control "no-store" always;
        return 404 "not found\n";
    }

    location = /metrics {
        default_type text/plain;
        add_header Cache-Control "no-store" always;
        return 404 "not found\n";
    }

    location = /mcp {
        default_type text/plain;
        add_header Cache-Control "no-store" always;
        return 404 "not found\n";
    }

    location ^~ /mcp/ {
        default_type text/plain;
        add_header Cache-Control "no-store" always;
        return 404 "not found\n";
    }

    location ^~ /v1/ {
        default_type text/plain;
        add_header Cache-Control "no-store" always;
        return 404 "not found\n";
    }

    location = /index.html {
        add_header Cache-Control "no-cache" always;
        include ${ASTERLANE_SECURITY_HEADERS};
    }

    location ^~ /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        include ${ASTERLANE_SECURITY_HEADERS};
        error_page 404 =404 @static_missing;
    }

    location @static_missing {
        internal;
        types { }
        default_type text/plain;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options "nosniff" always;
        return 404 "not found\n";
    }

    location ~* \.[A-Za-z0-9]+$ {
        try_files $uri =404;
        add_header Cache-Control "no-cache" always;
        include ${ASTERLANE_SECURITY_HEADERS};
        error_page 404 =404 @static_missing;
    }

    location / {
        try_files $uri /index.html;
    }
}
