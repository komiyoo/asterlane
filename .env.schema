# Asterlane 环境变量 schema（https://varlock.dev/env-spec/overview/）。
# 二进制不读取本文件，也不读取 .env。Compose 在变量未设置时使用这里的同一组缺省。
# 覆盖方式：export，或写入已被 gitignore 的 .env。不要提交真实上游密钥。
# @defaultRequired=false
# @defaultSensitive=false
# ---

# 离线 serve 与 list-tools 读取的 Gateway YAML。Compose 固定挂载 run.yaml，不使用这个变量。
ASTERLANE_CONFIG=examples/gateway.yaml

# 管理 API 口令。配置通过 secret://env/ASTERLANE_ADMIN_TOKEN 引用。
# 写在仓库里，供本机直接登录。入口暴露到公网前请覆盖。
# @sensitive=false
ASTERLANE_ADMIN_TOKEN=demo-admin-token-2026

# asterlane admin 与 tools 连接的网关。CLI 未设置时也是这个地址。
# @type=url
ASTERLANE_SERVER=http://127.0.0.1:3000

# Compose 把网关发布到本机的端口。
# @type=port
ASTERLANE_GATEWAY_PORT=3721

# Compose 把控制台发布到本机的端口。
# @type=port
ASTERLANE_WEB_PORT=3722

# 写入镜像 label 的提交号。
ASTERLANE_GIT_COMMIT=unknown

# vp dev 把 /admin 代理到 127.0.0.1 的这个端口。不进入生产包。
# @type=port
ASTERLANE_DEV_GATEWAY_PORT=3000

# secret://exa/default。不设时示例配置可以启动，Exa 调用会失败。
# @sensitive
EXA_DEFAULT=

# 仅 tests/it/mcp_proxy_integration.rs 的真实上游冒烟使用。
# @sensitive
ROLLINGGO_API_KEY=
