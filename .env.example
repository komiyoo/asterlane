# 这是变量清单，不是运行时自动加载文件。
# Asterlane 二进制不读取 .env；请 export，或把值传给 --config / --server / --token-env。
# 不要把填好的 .env 提交进 git，也不要从主仓 Worktree 拷贝含真实密钥的 .env。

ASTERLANE_CONFIG=examples/gateway.yaml
ASTERLANE_ADMIN_TOKEN=replace-me-admin-token
ASTERLANE_SERVER=http://127.0.0.1:3000

# 仅真实上游冒烟时填写
# EXA_DEFAULT=
# ROLLINGGO_API_KEY=
